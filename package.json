{
  "name": "stock-move-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev --workspace server\" \"npm:dev --workspace web\"",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "vercel-build": "npm run build --workspace web",
    "start": "npm run build && npm start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
