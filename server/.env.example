# 서버 포트 (기본값 4000)
PORT=4000

# ── 선택 사항 (설정하지 않아도 앱은 동작하지만, 아래 기능이 제한됩니다) ──

# Anthropic API 키. 설정하면 검색된 자료(공시/뉴스/커뮤니티)를 바탕으로
# 핵심 원인을 3단어 이내로 요약하고, 신뢰도와 상세 분석을 자동 생성합니다.
# 설정하지 않으면 검색된 원문 자료만 그대로 보여줍니다 (원인을 추측/요약하지 않음).
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=
# 요약에 사용할 모델 (기본값: claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=

# DART(전자공시시스템) Open API 키. 설정하면 종목별 최근 공시를 조회합니다.
# https://opendart.fss.or.kr/ 에서 무료 발급
DART_API_KEY=

# 네이버 검색 오픈API 키. 설정하면 국내 뉴스/투자 카페(커뮤니티) 검색 품질이 향상됩니다.
# 설정하지 않으면 Google News RSS로 대체됩니다.
# https://developers.naver.com/apps/#/register 에서 무료 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
